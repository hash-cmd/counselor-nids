[Unit]
Description=Counselor NIDS observer (routes flows to detectors)
After=nids-capture.service
PartOf=nids-capture.service nids.target

[Service]
User=@USER@
EnvironmentFile=/etc/nids/nids.env
WorkingDirectory=@ROOT@
NoNewPrivileges=yes
ExecStart=@ROOT@/.venv/bin/nids observe
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nids.target
