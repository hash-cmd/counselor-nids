# One live detector per instance: nids-detector@live_dos.service runs models/live/live_dos.joblib.
[Unit]
Description=Counselor NIDS detector %i
After=nids-capture.service
PartOf=nids-capture.service nids.target

[Service]
User=@USER@
EnvironmentFile=/etc/nids/nids.env
WorkingDirectory=@ROOT@
NoNewPrivileges=yes
# model files are pickles (loading one runs code): refuse any that does not match its checksum
ExecStartPre=/bin/sh -c 'cd models/live && sha256sum --quiet -c SHA256SUMS'
ExecStart=@ROOT@/.venv/bin/nids detect models/live/%i.joblib --sources live --cross-check --suppress-fallback
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nids.target
